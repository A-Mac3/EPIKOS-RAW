{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EPIKOS RAW",
  "version": "0.1.0",
  "identifier": "com.epikos.raw",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EPIKOS RAW",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "backgroundColor": "#111214"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "resources": {
      "../../../models/*.onnx": "models/"
    },
    "category": "Photography",
    "copyright": "EPIKOS. Lens data: Lensfun (CC BY-SA 3.0)."
  }
}
